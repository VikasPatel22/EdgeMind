# ==============================================================================
# EdgeMind AI Studio — Comprehensive Cross-Platform .gitignore
# Covers Windows, macOS, Linux, Python, AI models, IDEs, and local environments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Models, Checkpoints, & Large Binaries
# (Prevents multi-gigabyte weights from being committed to Git)
# ------------------------------------------------------------------------------
models/*
!models/.gitkeep

*.safetensors
*.ckpt
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.engine
*.h5
*.msgpack
*.tflite
*.weights

# ------------------------------------------------------------------------------
# 2. Generated Outputs & Temporary Studio Artifacts
# ------------------------------------------------------------------------------
outputs/*
!outputs/.gitkeep

# ------------------------------------------------------------------------------
# 3. Local Configuration & Secrets (Personal paths & API keys)
# ------------------------------------------------------------------------------
settings.json
config.json
!settings.example.json
!config.example.json

# Environment variables & secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
secrets.json
credentials.json
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 4. Python Bytecode, Caches, & Build Distributions
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller / Executables
*.manifest
*.spec

# Pip & Package managers
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 5. Virtual Environments (All major naming conventions & tools)
# ------------------------------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
conda/
.conda/
bin/
include/
Lib/
Scripts/

# ------------------------------------------------------------------------------
# 6. Deep Learning, Framework, & Model Hub Caches
# ------------------------------------------------------------------------------
.cache/
cache/
tmp/
.tmp/
temp/
huggingface/
.huggingface/
torch/
torch_extensions/
.triton/
.nv/
.cuda/

# ------------------------------------------------------------------------------
# 7. Operating System Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 8. IDEs, Editors, & Development Tools
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm
.idea/
*.iml
*.iws

# Gemini / Antigravity Agent Workspace
.gemini/
.agents/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
*.bak
*.tmp
.#*
#*#

# ------------------------------------------------------------------------------
# 9. Logs, Crash Dumps, & Telemetry
# ------------------------------------------------------------------------------
*.log
logs/
crash_dumps/
*.dmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 10. Tunnels, Proxies, & Networking Daemons
# ------------------------------------------------------------------------------
tunnel.log
ngrok.log
cloudflare.log
localtunnel.log
